{
  "name": "studbook",
  "version": "0.31.0",
  "private": true,
  "type": "module",
  "description": "Studbook — a bloodstock breeding game: simulated genotypes, a stallion market, seasonal racing.",
  "scripts": {
    "start": "node server/index.mjs",
    "serve": "node tools/serve.mjs",
    "test": "node tests/engine.test.mjs && node tests/token.test.mjs && node tests/ui.test.mjs && node tests/wallet-ui.test.mjs && node tests/design.test.mjs && node tests/server.test.mjs",
    "test:engine": "node tests/engine.test.mjs",
    "test:design": "node tests/design.test.mjs",
    "test:server": "node tests/server.test.mjs",
    "gate": "node tools/release-gate.mjs index.html",
    "gate:prod": "node tools/release-gate.mjs https://lsraiva.github.io/studbook/",
    "economy": "node tools/economy-report.mjs",
    "test:token": "node tests/token.test.mjs",
    "contracts": "node tools/compile-contracts.mjs",
    "test:ui": "node tests/ui.test.mjs",
    "backup": "node tools/backup.mjs",
    "deploy:sepolia": "node tools/deploy.mjs",
    "deploy:dry": "node tools/deploy.mjs --dry-run",
    "test:wallet": "node tests/wallet-ui.test.mjs",
    "test:browser": "playwright test"
  },
  "license": "MIT",
  "devDependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "@playwright/test": "1.65.1",
    "ethers": "^6.13.0",
    "jsdom": "^24.0.0",
    "solc": "0.8.24"
  }
}
